# SIGTUR-IMATUR — variables para Docker.
# Copiar a .env (que NO se sube a git) y completar:   copy .env.example .env

# Direcciones desde las que se entra al sistema, separadas por coma.
# La primera es la principal. Agregar la IP de esta PC en la red local
# (ipconfig -> "Dirección IPv4") y, si se usa, la del túnel de internet.
APP_URLS=http://localhost:8080,http://192.168.1.10:8080
PUERTO=8080

# Base de datos — CAMBIAR la contraseña antes del primer arranque.
DB_NAME=SIGTUR-IMATUR
DB_USER=postgres
DB_PASS=CAMBIAR_ESTA_CONTRASENA
DB_HOST=db
DB_PORT=5432

APP_DEBUG=false
APP_TIMEZONE=America/Caracas
SESSION_TIMEOUT=1800

# Respaldos: hora (0-23) y cuántos conservar.
HORA_RESPALDO=23
BACKUP_RETENTION=14

# Correo para recuperar contraseña (Gmail: contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-responder@imatur.gob.ve
